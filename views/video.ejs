<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · IT1A</title>
  <link rel="icon" type="image/jpeg" href="/img/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Chakra+Petch:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/video.css">
</head>
<body class="video-body">
  <%- include('partials/nav', { active: 'video', site }) %>
  
  <div class="video-container">
    <video class="video-main" src="/vid/video.mp4" autoplay loop playsinline muted></video>
    <div class="video-overlay"></div>
    
    <div class="video-content">
      <div class="heart-container">
        <svg class="heart-broken" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="heart-left" d="M30 35 Q20 25 20 40 Q20 55 35 70 L50 85 L65 70 Q80 55 80 40 Q80 25 70 35 Q60 25 50 35 Q40 25 30 35 Z" stroke="#ff4757" stroke-width="3" fill="none"/>
          <path class="heart-right" d="M70 35 Q80 25 80 40 Q80 55 65 70 L50 85 L35 70 Q20 55 20 40 Q20 25 30 35 Q40 25 50 35 Q60 25 70 35 Z" stroke="#ff4757" stroke-width="3" fill="none"/>
          <line class="crack" x1="50" y1="35" x2="50" y2="85" stroke="#ff4757" stroke-width="2" stroke-dasharray="5,5"/>
        </svg>
        <div class="particles" id="particles"></div>
      </div>
      
      <h1 class="video-title">Move on kana, hindi kana mahal</h1>
      
      <a href="/" class="btn-back">← Back to Home</a>
    </div>
  </div>

  <script>
    // Create floating particles
    const particlesContainer = document.getElementById('particles');
    const particleCount = 30;
    
    for (let i = 0; i < particleCount; i++) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      particle.style.left = Math.random() * 100 + '%';
      particle.style.top = Math.random() * 100 + '%';
      particle.style.animationDelay = Math.random() * 5 + 's';
      particle.style.animationDuration = (3 + Math.random() * 4) + 's';
      particlesContainer.appendChild(particle);
    }

    // Heart beat animation
    const hearts = document.querySelectorAll('.heart-left, .heart-right');
    setInterval(() => {
      hearts.forEach(h => {
        h.style.transform = 'scale(1.05)';
        setTimeout(() => h.style.transform = 'scale(1)', 150);
      });
    }, 1000);

    // Ensure video plays
    const video = document.querySelector('.video-main');
    video.play().catch(() => {
      video.muted = true;
      video.play();
    });
  </script>
</body>
</html>