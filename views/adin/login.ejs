<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Access Terminal · <%= site.title %></title>
  <link rel="icon" type="image/jpeg" href="/img/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Chakra+Petch:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-body">
  <div class="bg" aria-hidden="true">
    <div class="bg-hex"></div>
    <div class="bg-orb bg-orb-a"></div>
    <div class="bg-orb bg-orb-b"></div>
  </div>

  <main class="login-wrap">
    <form class="login-card" method="post" action="/adin/login" <%= error ? 'data-shake' : '' %>>
      <img class="login-logo" src="/img/logo.jpg" alt="IT1A logo" width="84" height="84">
      <h1 class="login-title">ACCESS TERMINAL</h1>
      <p class="login-sub mono">// authorized_personnel_only</p>

      <% if (error) { %>
        <p class="login-error mono" role="alert">! <%= error %></p>
      <% } %>

      <label class="field">
        <span class="field-label mono">password</span>
        <input type="password" name="password" required autocomplete="current-password" autofocus>
      </label>

      <button class="btn btn-primary btn-block" type="submit">Authenticate</button>
      <a class="login-back mono" href="/">&larr; return_to_site</a>
    </form>
  </main>
</body>
</html>
