<%- include('partials/head') %>
<%- include('partials/nav') %>

<main id="main">
  <section class="page-head special-head">
    <p class="kicker mono">// special_place</p>
    <h1>The Squad</h1>
    <p class="page-sub">One frame. The whole IT1A officers. Handle with pride.</p>
  </section>

  <section class="section special-section">
    <% if (groupPhoto && groupPhoto.url) { %>
      <figure class="special-frame reveal">
        <img src="<%= groupPhoto.url %>" alt="IT1A officers group photo">
        <figcaption class="mono">IT1A · BSIT DORSU — OFFICIAL GROUP PIC</figcaption>
      </figure>
    <% } else { %>
      <div class="special-frame special-frame-empty card reveal">
        <div class="special-placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="54" height="54" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </div>
        <p class="mono">// frame_reserved</p>
        <p>The frame is up. The group photo drops soon.</p>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
