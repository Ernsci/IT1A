<%- include('partials/head') %>
<%- include('partials/nav') %>

<main id="main">
  <section class="page-head">
    <p class="kicker mono">// gallery</p>
    <h1>Pictures</h1>
    <p class="page-sub">Proof that we actually touch grass. Occasionally.</p>
  </section>

  <section class="section">
    <% if (photos.length) { %>
      <div class="filter-row" role="group" aria-label="Filter by album">
        <button class="chip is-active" type="button" data-filter="*">All</button>
        <%
          var chipNames = albums.map(function (a) { return { name: a.name, desc: a.description }; });
          var seen = chipNames.map(function (c) { return c.name; });
          photos.forEach(function (p) {
            if (p.album && seen.indexOf(p.album) === -1) { seen.push(p.album); chipNames.push({ name: p.album, desc: '' }); }
          });
        %>
        <% chipNames.forEach(function (c) { var count = photos.filter(function (p) { return p.album === c.name; }).length; if (count > 0) { %>
          <button class="chip" type="button" data-filter="<%= c.name %>" <%= c.desc ? 'title="' + c.desc + '"' : '' %>><%= c.name %> <span class="chip-count"><%= count %></span></button>
        <% } }); %>
      </div>
      <div class="photo-grid" id="photo-grid">
        <% photos.forEach(function (ph, i) { %>
          <figure class="photo-card card reveal" data-album="<%= ph.album %>" data-date="<%= ph.created_at %>">
            <button class="photo-btn" type="button" data-index="<%= i %>" aria-label="Open photo: <%= ph.title || 'untitled' %>">
              <img src="<%= ph.url %>" alt="<%= ph.title || 'IT1A photo' %>" loading="lazy">
            </button>
            <figcaption>
              <span class="photo-title"><%= ph.title || 'Untitled' %></span>
              <span class="photo-date mono"></span>
              <% if (ph.caption) { %><span class="photo-caption"><%= ph.caption %></span><% } %>
            </figcaption>
          </figure>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty card">
        <p class="mono">// gallery_empty</p>
        <p>No photos yet. me stubborn</p>
      </div>
    <% } %>
  </section>
</main>

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <button class="lightbox-close" type="button" aria-label="Close">×</button>
  <img class="lightbox-img" src="" alt="">
  <div class="lightbox-meta">
    <p class="lightbox-title"></p>
    <p class="lightbox-caption mono"></p>
    <p class="lightbox-date mono"></p>
  </div>
  <div class="lightbox-nav">
    <button type="button" data-dir="-1" aria-label="Previous photo">←</button>
    <button type="button" data-dir="1" aria-label="Next photo">→</button>
  </div>
</dialog>

<%- include('partials/footer') %>
